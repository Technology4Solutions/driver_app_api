# Local configuration template. Copy to .env and fill in local settings.
# .env is private and ignored by Git. Deployment secrets come from Vault.
API_BIND=127.0.0.1:8080
ADMIN_BIND=127.0.0.1:9090
LOG_LEVEL=INFO
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_MAX_CONNECTIONS=5
DB_CONNECT_TIMEOUT_SECONDS=10
REAXIUM_API_USER=
REAXIUM_API_PASSWORD=
REAXIUM_API_PASSWORD_PREVIOUS=
DEVICE_STATUS_ZMQ_ENDPOINT=
DEVICE_STATUS_BROADCAST_TIMEOUT_SECONDS=
VISION_UDP_DESTINATION=
VISION_TIMEZONE=
VISION_ENABLED=
DASHBOARD_BROADCAST_ENABLED=
REAXIUM_API_JWT_SECRET=
