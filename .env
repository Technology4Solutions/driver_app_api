DB_PORT=3306
DB_NAME=school_bus
DB_USER=root
DB_PASSWORD=root
DB_MAX_CONNECTIONS=5
DB_CONNECT_TIMEOUT_SECONDS=10
# DeviceStatus Basic auth: use the shared ReaxiumCloud credentials.
REAXIUM_API_USER=MuIXaeR
REAXIUM_API_PASSWORD=BOCAKIOTO2020
REAXIUM_API_PASSWORD_PREVIOUS=BOCAKIOTO2020
DEVICE_STATUS_ZMQ_ENDPOINT=tcp://127.0.0.1:5555
